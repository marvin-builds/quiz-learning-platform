{
  "permissions": {
    "allow": [
      "Bash(npm run -s check)",
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run db:types)",
      "Bash(npx jest:*)",
      "Bash(npx tsc --noEmit:*)",
      "Bash(npx expo-doctor:*)",
      "Bash(npx prettier --check:*)",
      "Bash(npx supabase start)",
      "Bash(npx supabase stop)",
      "Bash(npx supabase status)",
      "Bash(npx supabase db reset)",
      "Bash(npx supabase test db)",
      "Bash(npx supabase db reset && npx supabase test db)",
      "Bash(npx supabase migration new:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(npx supabase link:*)",
      "Bash(npx supabase db push:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-tests.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.mjs",
            "timeout": 180
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.mjs",
            "timeout": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/unlock-tests.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/unlock-tests.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.mjs",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
